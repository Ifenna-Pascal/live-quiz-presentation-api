# APP
SERVER_ADDRESS="0.0.0.0:8081"
ENVIRONMENT=development
DB_DRIVER=postgres
MIGRATION_URL="file://db/migration"
TOKEN_SYMMETRIC_KEY=dev-only-secret-change-me-in-prod-0123456789
ACCESS_TOKEN_DURATION=15m
DB_SOURCE=postgresql://root:secret@postgres:5432/interactive_presenations?sslmode=disable

# POSTGRES 
POSTGRES_USER=root
POSTGRES_PASSWORD=secret
POSTGRES_DB=interactive_presenations
